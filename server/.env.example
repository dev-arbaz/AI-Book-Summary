# Port the Express server listens on.
PORT=4000

# development | production — gates verbose debug logging in logger.js
NODE_ENV=development

# Comma-separated in a real multi-origin setup, or a single origin.
# Never leave this as "*" once a real frontend origin exists.
CORS_ORIGIN=http://localhost:5173

# Max accepted upload size, in megabytes. Enforced by multer in
# upload.middleware.js — rejected before the file is even buffered.
MAX_FILE_SIZE_MB=25

# How long an uploaded document's extracted text stays in the in-memory
# store before the cleanup timer evicts it. See docs/SYSTEM_ARCHITECTURE.md
# for why this is in-memory instead of a database at MVP stage.
DOCUMENT_TTL_MINUTES=60

# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override — defaults to gemini-2.5-flash in constants.js if unset.
GEMINI_MODEL=gemini-3.6-flash

CHUNK_THRESHOLD_CHARS=150000

# How much of the document's ORIGINAL opening text to always extract
# title/author from, bypassing the condensed digest (which can lose a
# title page during condensation).
TITLE_EXTRACTION_CHARS=5000

# Target chunk size for the map step. Deliberately larger than
# CHUNK_THRESHOLD_CHARS above — measure your AI provider's actual
# requests-per-minute limit before changing this; the constraint is
# request COUNT, not context window size.
CHUNK_SIZE_CHARS=180000

# Delay between chunk-digest calls, to proactively stay under your
# provider's rate limit rather than firing fast and recovering from 429s.
CHUNK_CALL_DELAY_MS=7000

# Retry attempts per chunk on a rate-limit failure before failing loudly.
CHUNK_MAX_RETRIES=3

# Absolute hard ceiling on total document size, regardless of chunking —
# protects against a pathological upload turning into thousands of API
# calls. A genuinely oversized/corrupted extraction fails immediately
# with DOCUMENT_TOO_LARGE_TO_PROCESS instead of being processed at all.
MAX_DOCUMENT_CHARS=2000000